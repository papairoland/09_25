<Window x:Class="_09_25_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_09_25_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition />
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Slider x:Name="sliRed" TickFrequency="1" IsSnapToTickEnabled="True" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="255" ValueChanged="sliRed_ValueChanged"/>
        <Label Content="Red" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <Label x:Name="lblRed" Content="0" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="2" />
        <Slider x:Name="sliGreen" TickFrequency="1" IsSnapToTickEnabled="True" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Minimum="0" Maximum="255" ValueChanged="sliGreen_ValueChanged"/>
        <Label Content="Green" FontSize="15" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label x:Name="lblGreen" Content="0" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="2"/>
        <Slider x:Name="sliBlue" TickFrequency="1" IsSnapToTickEnabled="True" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="255" ValueChanged="sliBlue_ValueChanged"/>
        <Label Content="Blue" FontSize="15" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label x:Name="lblBlue" Content="0" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="2" />
        <Button x:Name="btnRogzit" Content="Rögzít" Grid.Row="3" Grid.Column="2" Margin="20" Height="40" Click="btnRogzit_Click"/>
        <Button x:Name="btnUres" Content="Üres lista" Height="30" Margin="20" Grid.Row="4" Grid.Column="2" VerticalAlignment="Top" Click="btnUres_Click"/>
        <Button x:Name="btnBetoltes" Content="Betöltés" Height="30" Margin="20" Grid.Row="4" Grid.Column="2" Click="btnBetoltes_Click"/>
        <Button x:Name="btnElmentes" Content="Elmentés" Height="30" Margin="20" Grid.Row="4" Grid.Column="2" VerticalAlignment="Bottom" Click="btnElmentes_Click"/>
        <ListBox x:Name="lbLista" Grid.Row="4" Grid.ColumnSpan="2" Margin="10" MouseDoubleClick="lbLista_MouseDoubleClick"/>
        <Rectangle x:Name="rctTeglalap" Grid.Row="3" Grid.ColumnSpan="2" Fill="Black" Margin="10"/>
    </Grid>
</Window>
